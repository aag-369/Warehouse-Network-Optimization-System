    optimization_result [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#A83232"><TR><TD BGCOLOR="#A83232" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OPTIMIZATION_RESULT</B></FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="result_id"><FONT POINT-SIZE="11"><B><U>result_id</U></B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="run_id"><FONT POINT-SIZE="11"><I>run_id</I></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="warehouse_id"><FONT POINT-SIZE="11"><I>warehouse_id</I></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11"><I>product_id</I></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="recommended_action"><FONT POINT-SIZE="11">recommended_action</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="recommended_qty"><FONT POINT-SIZE="11">recommended_qty</FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="projected_saving"><FONT POINT-SIZE="11">projected_saving</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="confidence_score"><FONT POINT-SIZE="11">confidence_score</FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="rationale"><FONT POINT-SIZE="11">rationale</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR></TABLE>>];
    kpi_snapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#A83232"><TR><TD BGCOLOR="#A83232" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>KPI_SNAPSHOT</B></FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="snapshot_id"><FONT POINT-SIZE="11"><B><U>snapshot_id</U></B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="warehouse_id"><FONT POINT-SIZE="11"><I>warehouse_id</I></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="snapshot_date"><FONT POINT-SIZE="11">snapshot_date</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="inventory_turnover"><FONT POINT-SIZE="11">inventory_turnover</FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(7,2)</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="order_fill_rate_pct"><FONT POINT-SIZE="11">order_fill_rate_pct</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="on_time_delivery_pct"><FONT POINT-SIZE="11">on_time_delivery_pct</FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="capacity_utilization_pct"><FONT POINT-SIZE="11">capacity_utilization_pct</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR><TR><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT" PORT="cost_per_order"><FONT POINT-SIZE="11">cost_per_order</FONT></TD><TD BGCOLOR="#FEF6F6" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(10,2)</FONT></TD></TR><TR><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT" PORT="carrying_cost"><FONT POINT-SIZE="11">carrying_cost</FONT></TD><TD BGCOLOR="#F8DCDC" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_admin {
    label=<<FONT POINT-SIZE="17" COLOR="#4A5568"><B>MODULE 7  SECURITY</B></FONT>>;
    style="rounded,filled"; fillcolor="#F7F9FB"; color="#4A5568"; penwidth=2;
    labeljust="l"; margin=18;
    app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#4A5568"><TR><TD BGCOLOR="#4A5568" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>APP_USER</B></FONT></TD></TR><TR><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="11"><B><U>user_id</U></B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="11">username</FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(40)</FONT></TD></TR><TR><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" PORT="full_name"><FONT POINT-SIZE="11">full_name</FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR><TR><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="11">email</FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" PORT="password_hash"><FONT POINT-SIZE="11">password_hash</FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" PORT="user_role"><FONT POINT-SIZE="11">user_role</FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" PORT="warehouse_id"><FONT POINT-SIZE="11"><I>warehouse_id</I></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="11">is_active</FONT></TD><TD BGCOLOR="#F7F9FB" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR><TR><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT" PORT="created_on"><FONT POINT-SIZE="11">created_on</FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
  }

  // ---------------- relationships (crow's foot) ----------------
  region:region_id:e -> location:region_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" contains "];
  location:location_id:e -> warehouse:location_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" sited at "];
  warehouse:warehouse_id:e -> warehouse_zone:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" divided into "];
  product_category:category_id:e -> product:category_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" classified as "];
  product_category:category_id:e -> product_category:parent_category_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" parent of "];
  location:location_id:e -> supplier:location_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" located at "];
  supplier:supplier_id:e -> supplier_product:supplier_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" supplies "];
  product:product_id:e -> supplier_product:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" supplied as "];
  location:location_id:e -> customer:location_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" located at "];
  warehouse:warehouse_id:e -> inventory:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" stocks "];
  product:product_id:e -> inventory:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" stocked as "];
  warehouse_zone:zone_id:e -> inventory:zone_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" stored in "];
  inventory:inventory_id:e -> inventory_transaction:inventory_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" logged by "];
  customer:customer_id:e -> customer_order:customer_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" places "];
  customer_order:order_id:e -> order_line:order_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" itemised by "];
  product:product_id:e -> order_line:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" ordered as "];
  customer_order:order_id:e -> order_fulfilment:order_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" fulfilled by "];
  warehouse:warehouse_id:e -> order_fulfilment:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" allocated to "];
  warehouse:warehouse_id:e -> demand_forecast:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" forecast for "];
  product:product_id:e -> demand_forecast:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" forecast of "];
  carrier:carrier_id:e -> vehicle:carrier_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" operates "];
  location:location_id:e -> transport_lane:origin_location_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" origin "];
  location:location_id:e -> transport_lane:dest_location_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" destination "];
  transport_lane:lane_id:e -> shipment:lane_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" routed on "];
  carrier:carrier_id:e -> shipment:carrier_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" carried by "];
  vehicle:vehicle_id:e -> shipment:vehicle_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" loaded on "];
  warehouse:warehouse_id:e -> shipment:origin_warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" despatched from "];
  shipment:shipment_id:e -> shipment_line:shipment_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" consolidates "];
  order_line:order_line_id:e -> shipment_line:order_line_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" ships "];
  warehouse:warehouse_id:e -> stock_transfer:from_warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" transfers from "];
  warehouse:warehouse_id:e -> stock_transfer:to_warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" transfers to "];
  product:product_id:e -> stock_transfer:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" moves "];
  shipment:shipment_id:e -> stock_transfer:shipment_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" moved by "];
  optimization_scenario:scenario_id:e -> optimization_run:scenario_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" evaluates "];
  optimization_run:run_id:e -> optimization_result:run_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" produces "];
  warehouse:warehouse_id:e -> optimization_result:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" targets "];
  product:product_id:e -> optimization_result:product_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" targets SKU "];
  warehouse:warehouse_id:e -> kpi_snapshot:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowtee, style=solid, xlabel=" measured by "];
  warehouse:warehouse_id:e -> app_user:warehouse_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, xlabel=" scoped to "];
}