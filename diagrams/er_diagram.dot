digraph WNOS_ER {
  graph [rankdir=TB, splines=spline, overlap=false, nodesep=1.0, ranksep=0.7,
         fontname="Helvetica", bgcolor="white", pad=0.5, concentrate=false];
  node  [shape=plaintext, fontname="Helvetica"];
  edge  [fontname="Helvetica", fontsize=9, color="#5A6472", penwidth=1.2,
         labeldistance=1.6, labelfontsize=8, labelfontcolor="#4A5568"];

  labelloc="t";
  label=<<FONT POINT-SIZE="34"><B>Warehouse Network Optimization System</B></FONT><BR/><FONT POINT-SIZE="18">Entity-Relationship Diagram of the Proposed Model  &#183;  26 Entities  &#183;  39 Relationships  &#183;  Crow's-Foot Notation</FONT><BR/><FONT POINT-SIZE="13" COLOR="#555555"><B>PK</B> Primary Key &#160;&#160; <B>FK</B> Foreign Key &#160;&#160; <B>UQ</B> Unique &#160;&#160; <B>GEN</B> Generated Column &#160;&#160;&#160; Connector:  &#8214;&#8212;&lt; reads as "one to many",  dashed = optional (nullable FK)</FONT><BR/> >;

  subgraph cluster_geo {
    label=<<FONT POINT-SIZE="17" COLOR="#1F4E79"><B>MODULE 1  GEOGRAPHY AND NETWORK MASTER</B></FONT>>;
    style="rounded,filled"; fillcolor="#F4F9FD"; color="#1F4E79"; penwidth=2;
    labeljust="l"; margin=18;
    region [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>REGION</B></FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="region_id"><FONT POINT-SIZE="11"><B><U>region_id</U></B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="region_code"><FONT POINT-SIZE="11">region_code</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="region_name"><FONT POINT-SIZE="11">region_name</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="country"><FONT POINT-SIZE="11">country</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR></TABLE>>];
    location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>LOCATION</B></FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="location_id"><FONT POINT-SIZE="11"><B><U>location_id</U></B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="city"><FONT POINT-SIZE="11">city</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="state"><FONT POINT-SIZE="11">state</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="postal_code"><FONT POINT-SIZE="11">postal_code</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(12)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="latitude"><FONT POINT-SIZE="11">latitude</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(9,6)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="longitude"><FONT POINT-SIZE="11">longitude</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(9,6)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="region_id"><FONT POINT-SIZE="11"><I>region_id</I></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR></TABLE>>];
    warehouse [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>WAREHOUSE</B></FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="warehouse_id"><FONT POINT-SIZE="11"><B><U>warehouse_id</U></B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="warehouse_code"><FONT POINT-SIZE="11">warehouse_code</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(12)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="warehouse_name"><FONT POINT-SIZE="11">warehouse_name</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="location_id"><FONT POINT-SIZE="11"><I>location_id</I></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="warehouse_type"><FONT POINT-SIZE="11">warehouse_type</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="storage_capacity_units"><FONT POINT-SIZE="11">storage_capacity_units</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="throughput_per_day"><FONT POINT-SIZE="11">throughput_per_day</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="fixed_cost_monthly"><FONT POINT-SIZE="11">fixed_cost_monthly</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="variable_cost_per_unit"><FONT POINT-SIZE="11">variable_cost_per_unit</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(10,4)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="automation_level"><FONT POINT-SIZE="11">automation_level</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="opened_date"><FONT POINT-SIZE="11">opened_date</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="11">status</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR></TABLE>>];
    warehouse_zone [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F4E79"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>WAREHOUSE_ZONE</B></FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="zone_id"><FONT POINT-SIZE="11"><B><U>zone_id</U></B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="warehouse_id"><FONT POINT-SIZE="11"><I>warehouse_id</I></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="zone_code"><FONT POINT-SIZE="11">zone_code</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="zone_type"><FONT POINT-SIZE="11">zone_type</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="capacity_units"><FONT POINT-SIZE="11">capacity_units</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT" PORT="temp_min_c"><FONT POINT-SIZE="11">temp_min_c</FONT></TD><TD BGCOLOR="#F4F9FD" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR><TR><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT" PORT="temp_max_c"><FONT POINT-SIZE="11">temp_max_c</FONT></TD><TD BGCOLOR="#DBE9F5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(5,2)</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_prod {
    label=<<FONT POINT-SIZE="17" COLOR="#8A5A2B"><B>MODULE 2  PRODUCT AND SUPPLY MASTER</B></FONT>>;
    style="rounded,filled"; fillcolor="#FDF8F2"; color="#8A5A2B"; penwidth=2;
    labeljust="l"; margin=18;
    product_category [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A5A2B"><TR><TD BGCOLOR="#8A5A2B" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PRODUCT_CATEGORY</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="11"><B><U>category_id</U></B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="category_name"><FONT POINT-SIZE="11">category_name</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="parent_category_id"><FONT POINT-SIZE="11"><I>parent_category_id</I></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR></TABLE>>];
    product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A5A2B"><TR><TD BGCOLOR="#8A5A2B" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PRODUCT</B></FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#B7791F" POINT-SIZE="9"><B>PK</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11"><B><U>product_id</U></B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2F855A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="sku"><FONT POINT-SIZE="11">sku</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(20)</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="product_name"><FONT POINT-SIZE="11">product_name</FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#2B6CB0" POINT-SIZE="9"><B>FK</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="11"><I>category_id</I></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="unit_weight_kg"><FONT POINT-SIZE="11">unit_weight_kg</FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(8,3)</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="unit_volume_m3"><FONT POINT-SIZE="11">unit_volume_m3</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(8,4)</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="unit_cost"><FONT POINT-SIZE="11">unit_cost</FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(10,2)</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="unit_price"><FONT POINT-SIZE="11">unit_price</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">DECIMAL(10,2)</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="shelf_life_days"><FONT POINT-SIZE="11">shelf_life_days</FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="storage_type"><FONT POINT-SIZE="11">storage_type</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT" PORT="abc_class"><FONT POINT-SIZE="11">abc_class</FONT></TD><TD BGCOLOR="#F3E5D5" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">CHAR(1)</FONT></TD></TR><TR><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" WIDTH="46"><FONT COLOR="#000000" POINT-SIZE="9"><B>&#160;</B></FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT" PORT="is_hazmat"><FONT POINT-SIZE="11">is_hazmat</FONT></TD><TD BGCOLOR="#FDF8F2" ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
